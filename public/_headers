# Netlify serves this site (see _redirects) — the `headers` block in
# firebase.json is not applied to anything and cannot be used to fix this.
#
# Without this rule the manifest goes out as application/octet-stream. Browsers
# parse it regardless, so the install prompt works either way, but the type is
# wrong and stricter tools flag it.
/site.webmanifest
  Content-Type: application/manifest+json
