rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /builds/{build} {
      // Public numbers on every build. No client may SET one; a write may only
      // step one of them by one (see the counter branch below). Before this,
      // the rule checked which keys changed but never by how much, so a single
      // console write could give a build a million views.
      //
      // These two lists mirror NON_EDITABLE_FIELDS in
      // src/composables/data/buildService.js, which keeps the editor from
      // sending them. Transcribed, because rules cannot import: change both.
      function counters() {
        return ['views', 'likes', 'upvotes', 'downvotes', 'comments'];
      }
      // Written only by the scheduled jobs (Admin SDK, which bypasses rules).
      // `trend*` is the recency bookkeeping of updateBuildTrend.
      function serverOwned() {
        return ['score', 'scoreAllTime', 'trend', 'trendBase', 'trendAt'];
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // `increment()` is resolved before rules run, so this sees the value the
      // write produces. A field missing from an old build reads as 0, which is
      // also what increment() starts it from.
      function stepped(f, allowDown) {
        let before = resource.data.get(f, 0);
        let after = request.resource.data.get(f, 0);
        return after == before + 1 || (allowDown && after == before - 1);
      }
      function startsAtZero(f) {
        return !(f in request.resource.data) || request.resource.data[f] == 0;
      }

      allow read;

      // The author's own writes, split by operation because each must check a
      // different document.
      //
      // On an update, `request.resource.data` is the document AFTER the write,
      // so its authorUid is whatever the caller just sent. It must never be
      // what grants the update: the rule this replaced accepted it, and any
      // signed-in user could take over someone else's build by writing their
      // own uid into authorUid in the same request. An update is granted by
      // the EXISTING author (`resource.data`), and authorUid may not change.
      //
      // A create has no existing document, so there the incoming authorUid is
      // the right thing to check: you may only create a build in your own name.
      // A new build starts every counter and score at zero, and carries no
      // trend bookkeeping at all: the job seeds that on its first sight of it.
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && startsAtZero('views') && startsAtZero('likes')
                    && startsAtZero('upvotes') && startsAtZero('downvotes')
                    && startsAtZero('comments')
                    && startsAtZero('score') && startsAtZero('scoreAllTime')
                    && !request.resource.data.keys().hasAny(['trend', 'trendBase', 'trendAt']);

      // An author's edit leaves the numbers alone. Unchanged keys are not in
      // changed(), so sending a counter at its current value is harmless; what
      // is refused is a stale copy overwriting views gained meanwhile.
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && !changed().hasAny(counters().concat(serverOwned()));

      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;

      // Counter steps, from anyone the branch allows (the author included).
      // Exactly one key per write — every client write is one already. A view
      // is anonymous and only ever goes up; likes, votes and comments need an
      // account, as the UI already does, and may be taken back.
      allow update: if changed().size() == 1
                    && ((changed().hasOnly(['views']) && stepped('views', false))
                        || (request.auth != null
                            && ((changed().hasOnly(['likes']) && stepped('likes', true))
                                || (changed().hasOnly(['upvotes']) && stepped('upvotes', true))
                                || (changed().hasOnly(['downvotes']) && stepped('downvotes', true))
                                || (changed().hasOnly(['comments']) && stepped('comments', true)))));
    }
  }
  match /databases/{database}/documents {
    match /creators/{creator} {
      // S2 fix: restrict writes to the creator's own document
      allow read, write: if request.auth != null && request.auth.uid == creator;
    }
    match /creators/{creator} {
      allow read;
    }
  }
  match /databases/{database}/documents {
    match /comments/{comment} {
      // S3 fix: restrict writes to the comment author
      allow read;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }
  }
  match /databases/{database}/documents {
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
  match /databases/{database}/documents {
    match /contributors/{contributor} {
      // The introduction and the three profile links are the only fields here a
      // client may write that are read back as content rather than as a number,
      // so they are the only ones needing validation rather than just a key list.
      //
      // ANCHORED DELIBERATELY. matches() is RE2 and is NOT implicitly anchored:
      // without ^...$ a value like https://evil.example/@x satisfies the handle
      // branch, and the guarantee that a profile link can only point at the site
      // it names is gone. These patterns live in
      // src/composables/useContributorProfile.js — transcribed, because rules
      // cannot import, so the two change together or the form promises
      // something the server refuses.
      //
      // Each stored value is an IDENTIFIER, never a URL: a channel id or handle,
      // a Twitch login, an aoe4world player id. The address is composed at
      // render time, which is what makes the destination impossible for a
      // contributor to choose.
      //
      // The `in` guards are what permit clearing a field: deleteField() removes
      // the key from request.resource.data, and a bare size() check would
      // refuse the very operation the account page exists to perform.
      //
      // 180 is BIO_MAX_LENGTH in that same module.
      function profileFieldsValid() {
        return (!('bio' in request.resource.data)
                || (request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 180))
            && (!('youtube' in request.resource.data)
                || (request.resource.data.youtube is string
                    && request.resource.data.youtube.matches(
                         '^(UC[A-Za-z0-9_-]{22}|@[A-Za-z0-9._-]{3,30})$')))
            && (!('twitch' in request.resource.data)
                || (request.resource.data.twitch is string
                    && request.resource.data.twitch.matches('^[A-Za-z0-9_]{4,25}$')))
            && (!('aoe4world' in request.resource.data)
                || (request.resource.data.aoe4world is string
                    && request.resource.data.aoe4world.matches('^[0-9]{1,20}$')));
      }

      allow read;
      // The two totals, stepped like a build's counters (see builds/{build}).
      //
      // viewCount +1 is public because a build view raises its author's total
      // too, and most views are anonymous. Only the contributor may LOWER it,
      // by any amount: deleting a build removes that build's views in one write
      // (BuildDetails handleDelete), and lowering your own total gains nothing.
      //
      // boCount moves only on the author's own create and delete, so only the
      // contributor steps it, by one.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && (request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0) + 1
                        || (request.auth != null && request.auth.uid == contributor
                            && request.resource.data.get('viewCount', 0) < resource.data.get('viewCount', 0)));
      allow update: if request.auth != null && request.auth.uid == contributor
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boCount'])
                    && (request.resource.data.get('boCount', 0) == resource.data.get('boCount', 0) + 1
                        || request.resource.data.get('boCount', 0) == resource.data.get('boCount', 0) - 1);

      // The owner's own presentation: avatar, introduction, channel.
      //
      // `authorId` is in the key list because the profile write sends it, and
      // a record old enough to lack the field would otherwise show it as an
      // unexpected change and be refused. Pinned when present, so including it
      // grants nothing — and guarded with `in` so that the avatar write, which
      // does not send it, still works against such a record.
      //
      // `rank` appears in no list on this rule. That absence is what stops a
      // client awarding itself a standing; only updateHomeSnapshot writes it,
      // on the Admin SDK, which bypasses these rules entirely.
      allow update: if request.auth != null
                    && request.auth.uid == contributor
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['authorId', 'icon', 'bio', 'youtube', 'twitch', 'aoe4world'])
                    && (!('authorId' in request.resource.data)
                        || request.resource.data.authorId == contributor)
                    && profileFieldsValid();

      // A repair path, not a normal one. Both the createContributor auth
      // trigger and the updateContributorDisplayName callable create this
      // record on the Admin SDK, so it is reachable only by an account whose
      // setup never completed — where a plain update fails with not-found and
      // leaves the person with no way to proceed.
      //
      // It deliberately cannot supply displayName, boCount or viewCount: a
      // client may not name itself or award itself statistics. A record created
      // this way therefore has no display name, which is why no surface renders
      // a contributor without one.
      allow create: if request.auth != null
                    && request.auth.uid == contributor
                    && request.resource.data.keys()
                         .hasOnly(['authorId', 'icon', 'bio', 'youtube', 'twitch', 'aoe4world'])
                    && request.resource.data.authorId == contributor
                    && profileFieldsValid();
    }
  }
  match /databases/{database}/documents {
    match /home/{home} {
      allow read;
    }
  }
}
